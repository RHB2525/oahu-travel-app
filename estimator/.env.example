# Copy to .env.local for local dev; set the same vars in Vercel → Project → Settings → Environment Variables.

# Server-side only (no VITE_ prefix) so it is never shipped to the browser.
ANTHROPIC_API_KEY=""

# Supabase (optional). With these set, users sign in and estimates are saved to their account.
# Without them, everything is saved in the browser only. The anon/publishable key is safe in the browser;
# row-level security limits each user to their own data.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
